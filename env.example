# Copy this file to `.env` (cp env.example .env) before running.
# Never commit your real .env — it's in .gitignore.

# Anthropic — get from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Charles Schwab — from developer.schwab.com after app approval (1–3 business days)
SCHWAB_APP_KEY=your_app_key_here
SCHWAB_APP_SECRET=your_app_secret_here
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182

# Alpaca — instant signup at alpaca.markets, generate paper-trading keys to start.
# Switch broker.provider to `alpaca` in config.yaml to route through these.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Optional: Slack webhook for alerts
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
